# prana-bindu configuration (all optional; defaults shown). See README.md § Configuration.

# Data directory: SQLite database (prana.db) and, with the fs driver, attachment blobs (blobs/).
PRANA_DATA_DIR=./data
PRANA_PORT=3000
# Public origin the browser uses. The WebAuthn RP ID is its hostname, so passkeys are bound to it.
PRANA_ORIGIN=http://localhost:3000
PRANA_RP_NAME=prana-bindu
# Default time zone for the timeZone setting (IANA name). Defaults to the server's zone.
# PRANA_TIMEZONE=Europe/London

# Attachment storage: fs (under PRANA_DATA_DIR) or s3.
PRANA_BLOB_DRIVER=fs
# Required when PRANA_BLOB_DRIVER=s3:
# PRANA_S3_ENDPOINT=https://s3.example.com
# PRANA_S3_REGION=us-east-1
# PRANA_S3_BUCKET=prana-attachments
# PRANA_S3_ACCESS_KEY_ID=
# PRANA_S3_SECRET_ACCESS_KEY=
# PRANA_S3_FORCE_PATH_STYLE=true

# Database backups (prana-bindu backup). Once any PRANA_BACKUP_S3_* variable is set, all five are required.
# PRANA_BACKUP_S3_ENDPOINT=https://s3.example.com
# PRANA_BACKUP_S3_REGION=us-east-1
# PRANA_BACKUP_S3_BUCKET=prana-backups
# PRANA_BACKUP_S3_ACCESS_KEY_ID=
# PRANA_BACKUP_S3_SECRET_ACCESS_KEY=
# PRANA_BACKUP_S3_FORCE_PATH_STYLE=true
# PRANA_BACKUP_PREFIX=backups/
# PRANA_BACKUP_RETENTION_DAYS=30

# Mail Drop (prana-bindu serve): messages in a Fastmail mailbox become inbox items. Off unless both are set.
# PRANA_MAIL_DROP_FASTMAIL_TOKEN=
# PRANA_MAIL_DROP_MAILBOX=Mail Drop
# PRANA_MAIL_DROP_SESSION_URL=https://api.fastmail.com/jmap/session
